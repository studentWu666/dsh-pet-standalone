{
  "name": "dsh-pet-standalone",
  "version": "1.0.0",
  "description": "吃白饭的蓝色大肥鱼，独立桌面宠物。不依赖任何编辑器或宿主应用：双击即出现透明置顶小窗，可以拖拽、甩动、右键点播动作，接上自己的大模型 API 后还会碎碎念与聊天。（独立版改造自 PC2005-cloud/dsh-pet，原作者 PC2005-cloud）",
  "keywords": [
    "desktop-pet",
    "pet",
    "floating-widget",
    "electron",
    "standalone",
    "dsh-pet"
  ],
  "author": "PC2005-cloud (https://github.com/PC2005-cloud)",
  "contributors": [
    "studentWu666 (standalone edition, https://github.com/studentWu666)"
  ],
  "homepage": "https://github.com/studentWu666/dsh-pet-standalone#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studentWu666/dsh-pet-standalone.git"
  },
  "bugs": {
    "url": "https://github.com/studentWu666/dsh-pet-standalone/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-pet": "lib/main.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "runtime/electron-helper",
    "assets/webm",
    "assets/fonts",
    "assets/pic",
    "assets/memes",
    "assets/config.jsonc",
    "assets/logo.png",
    "scripts/ensure-electron.mjs"
  ],
  "scripts": {
    "bundle": "tsdown",
    "build:desktop-core": "node scripts/build-desktop-core.mjs",
    "build": "node scripts/prepare.js",
    "start": "node lib/main.js",
    "dev": "tsdown --watch",
    "package:portable": "node scripts/package-portable.mjs",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "test": "node --experimental-strip-types --import ./scripts/test-register.mjs --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "node --test scripts/tests/desktop-macos.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/get": "^5.1.0",
    "openai": "7.39.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "rolldown": "1.0.0-beta.7",
    "tsdown": "^0.8.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "rolldown": "1.0.0-beta.7"
  }
}
